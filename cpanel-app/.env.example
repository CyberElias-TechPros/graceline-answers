# Copy to .env (or set in cPanel "Setup Node.js App" -> Environment Variables).
# The Node.js app panel starts this file; the same file is used by `node app.js`.

PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# JWT signing key. MUST be a strong, unique, at-least-32-char string in production;
# the app refuses to start in production with a missing/weak value.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Bootstrap counselor (admin) created on first boot when the users table is empty.
ADMIN_BOOTSTRAP_EMAIL=pastor@example.com
ADMIN_BOOTSTRAP_PASSWORD=change_me_now

# Public base URL (no trailing slash). Used in email links, sitemap, RSS, canonical.
PUBLIC_BASE_URL=https://your-domain.com

# Optional: override the SQLite file location. Defaults to <repo>/data/app.sqlite.
# Use ':memory:' only for tests/CI.
# DB_PATH=/home/youruser/graceline-answers/data/app.sqlite

# SMTP — use the credentials from your cPanel "Email Accounts" page.
SMTP_HOST=mail.your-domain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notify@your-domain.com
SMTP_PASS=your_mailbox_password
SMTP_FROM="GraceLine Answers <notify@your-domain.com>"
