{
  "name": "graceline-answers",
  "version": "0.2.0",
  "private": true,
  "description": "GraceLine Answers — anonymous Bible Q&A and faith-centered Christian counseling. Single Node.js app for cPanel/DirectAdmin shared hosting.",
  "main": "app.js",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node app.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "postinstall": "echo 'Install complete. Next: npm run build, then restart the Node.js app in cPanel.'"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "lucide-react": "^0.575.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "vite": "^5.4.8"
  }
}
