{
  "name": "@graceline/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GraceLine Answers API — Cloudflare Worker (D1 + KV + Queues + Durable Objects + Cron)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply graceline-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply graceline-db --remote",
    "seed:local": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.7.10",
    "jose": "^6.0.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.71",
    "@cloudflare/workers-types": "^4.20250906.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "3.2.4",
    "wrangler": "4.35.0"
  }
}
